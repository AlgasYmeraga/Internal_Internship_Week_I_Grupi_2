#include <stdio.h>

int main() {
    int mosha, opsioni;
    char iniciali;
    double piket;

    // Input
    printf("Shkruaj moshen: ");
    scanf("%d", &mosha);

    printf("Shkruaj inicialin: ");
    scanf(" %c", &iniciali); // space para %c per input korrekt

    printf("Shkruaj piket paraprake: ");
    scanf("%lf", &piket);

    printf("Zgjidh punetorine (1-3): ");
    scanf("%d", &opsioni);

    // Kontrolli i moshes
    if(mosha < 10 || mosha > 18) {
        printf("\nNuk lejohet pjesemarrja (mosha jashte kufirit)\n");
    }

    // Klasifikimi me if/else
    if(piket < 50) {
        printf("Statusi: Nevojitet me shume ushtrim\n");
    }
    else if(piket < 80) {
        printf("Statusi: Gati per vazhdim\n");
    }
    else {
        printf("Statusi: Gati per sfide\n");
    }

    // Switch per punetorine
    switch(opsoni) {
        case 1:
            printf("Punetoria: Programim bazik\n");
            break;
        case 2:
            printf("Punetoria: Web development\n");
            break;
        case 3:
            printf("Punetoria: Data & AI\n");
            break;
        default:
            printf("Opsion i pavlefshem\n");
    }

    // Output final
    printf("\n--- Permbledhje ---\n");
    printf("Mosha: %d\n", mosha);
    printf("Iniciali: %c\n", iniciali);
    printf("Piket: %.2lf\n", piket);

    return 0;
}
